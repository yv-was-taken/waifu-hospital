# AI Service Environment Variables

# Server Configuration
PORT=5001
NODE_ENV=development

# Backend Service URL (for fetching character data)
BACKEND_URL=http://localhost:5000

# OpenAI API Keys
OPENAI_CHAT_API_KEY=sk-your-openai-chat-api-key
OPENAI_IMAGE_API_KEY=sk-your-openai-image-api-key

# Docker Compose Service Names (use these when running with Docker)
# BACKEND_URL=http://backend:5000