# Backend Service Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/waifu-hospital

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# Microservices
AI_SERVICE_URL=http://localhost:5001

# Cloudflare Images Service
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ACCOUNT_HASH=your-cloudflare-account-hash
CLOUDFLARE_IMAGES_API_KEY=your-cloudflare-images-api-key

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# E-commerce Integrations
PRINTFUL_STORE_API_KEY=your-printful-api-key
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_SHOP=your-shop.myshopify.com

# Docker Compose Service Names (use these when running with Docker)
# AI_SERVICE_URL=http://ai_service:5001
# MONGODB_URI=mongodb://mongo:27017/waifu-hospital