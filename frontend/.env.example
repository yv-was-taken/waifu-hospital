# Frontend Service Environment Variables

# Backend API Endpoint
REACT_APP_API_URL=http://localhost:5000

# AI Service Endpoint (optional - for direct AI calls from frontend)
REACT_APP_AI_SERVICE_URL=http://localhost:5001

# Docker Compose Service Names (use these when running with Docker)
# REACT_APP_API_URL=http://backend:5000
# REACT_APP_AI_SERVICE_URL=http://ai_service:5001